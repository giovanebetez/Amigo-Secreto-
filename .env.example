# Quantidade de pessoas para o sorteio automático (padrão: 15)
MAX_PARTICIPANTS=15

# Banco de dados principal na Vercel: Neon Postgres
# Conecte em Storage -> Create Database -> Neon no painel da Vercel (injeta DATABASE_URL / POSTGRES_URL)
# DATABASE_URL=

# Alternativas também suportadas (caso prefira):
# BLOB_READ_WRITE_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# Opcional: senha secreta para reiniciar o jogo via POST /api/admin/reset
# ADMIN_SECRET=
