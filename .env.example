# Quantidade de pessoas para o sorteio automático (padrão: 15)
MAX_PARTICIPANTS=15

# Banco de dados na Vercel (conecte Upstash Redis / Vercel KV OU Redis no painel Storage da Vercel)
# Opção 1: Upstash Redis / Vercel KV (REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opção 2: Redis padrão (TCP)
# REDIS_URL=

# Opcional: senha secreta para reiniciar o jogo via POST /api/admin/reset
# ADMIN_SECRET=
